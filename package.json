{
  "name": "@edgecasesystems/secondlook-public",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:invariants": "vitest run test/judgment.test.ts test/openapi.test.mjs test/payments.test.ts test/paid-endpoint.test.ts test/x402.test.ts",
    "verify": "npm run typecheck && npm test",
    "verify:offline": "npm run typecheck && npm test && wrangler deploy --dry-run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.31.0"
  },
  "license": "UNLICENSED"
}
